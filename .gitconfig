# Identity
[user]
  name = tyler
  email = tolurbot@proton.me

# Signing
[user]
  signingkey = ~/.ssh/id_ed25519.pub
[gpg]
  format = ssh
[commit]
  gpgsign = true
[tag]
  gpgsign = true

# Editor and pager
[core]
  editor = nvim
	pager = (command -v diff-so-fancy >/dev/null 2>&1) && (diff-so-fancy | less --tabs=4 -RF) || less
[pager]
  branch = false

# Desired branching workflow:
#  - Local master tracks origin/master
#  - New branches automatically track the local branch they were created from
#  - Merges default to the local upstream
#  - Pushes default to a remote branch at origin with the same name
[branch]
  autoSetupMerge = always
[remote]
  pushDefault = origin
[push]
  default = current

# Misc convenience settings
[core]
  excludesfile = .local_gitignore
[alias]
  lg = log --graph --pretty=format:'%C(red)%h%C(reset) -%C(yellow)%d%C(reset) %s %C(green)(%cr) %C(bold blue)<%an>%C(reset)'
[rerere]  # REuse REcorded REsolution
	enabled = true

# Authentication and certificates
[credential "https://github.com"]
  helper = !/usr/bin/gh auth git-credential
[http]
	sslCAInfo = /usr/local/share/ca-certificates/homelab_ca.crt
